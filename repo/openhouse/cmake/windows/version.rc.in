// Version information for @LH_RC_NAME@ (cmake/windows/lh_windows_resources.cmake).
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION     @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
PRODUCTVERSION  @PROJECT_VERSION_MAJOR@,@PROJECT_VERSION_MINOR@,@PROJECT_VERSION_PATCH@,0
FILEFLAGSMASK   0x3fL
FILEFLAGS       0x0L
FILEOS          VOS_NT_WINDOWS32
FILETYPE        @LH_RC_FILETYPE@
FILESUBTYPE     0x0L
BEGIN
  BLOCK "StringFileInfo"
  BEGIN
    BLOCK "040904b0"
    BEGIN
      VALUE "CompanyName", "openhouse project"
      VALUE "FileDescription", "@LH_RC_DESCRIPTION@"
      VALUE "FileVersion", "@PROJECT_VERSION@"
      VALUE "InternalName", "@LH_RC_NAME@"
      VALUE "LegalCopyright", "MIT License, openhouse contributors"
      VALUE "OriginalFilename", "@LH_RC_FILENAME@"
      VALUE "ProductName", "openhouse"
      VALUE "ProductVersion", "@PROJECT_VERSION@"
      VALUE "Comments", "https://github.com/YusufOzmen01/openhouse"
    END
  END
  BLOCK "VarFileInfo"
  BEGIN
    VALUE "Translation", 0x409, 1200
  END
END
@LH_RC_MANIFEST@
