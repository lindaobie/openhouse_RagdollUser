# Windows only: version information (and, for executables, an asInvoker manifest) in
# each binary. Unsigned binaries without them score worse with Windows Defender.
#   lh_windows_resources(TARGET "File description")
function(lh_windows_resources target description)
  if(NOT WIN32)
    return()
  endif()
  get_target_property(type ${target} TYPE)
  get_target_property(output ${target} OUTPUT_NAME)
  if(NOT output)
    set(output ${target})
  endif()
  set(LH_RC_NAME ${target})
  set(LH_RC_DESCRIPTION "${description}")
  if(type STREQUAL "EXECUTABLE")
    set(LH_RC_FILETYPE VFT_APP)
    set(LH_RC_FILENAME "${output}.exe")
    file(TO_CMAKE_PATH "${PROJECT_SOURCE_DIR}/cmake/windows/app.manifest" manifest)
    set(LH_RC_MANIFEST "1 24 \"${manifest}\"")
    if(MSVC)
      # The .rc carries the manifest; MSVC's linker would add a second one (CVT1100).
      target_link_options(${target} PRIVATE /MANIFEST:NO)
    endif()
  else()
    set(LH_RC_FILETYPE VFT_DLL)
    set(LH_RC_FILENAME "${output}.dll")
    set(LH_RC_MANIFEST "")
  endif()
  set(rc "${CMAKE_CURRENT_BINARY_DIR}/rc/${target}.rc")
  configure_file("${PROJECT_SOURCE_DIR}/cmake/windows/version.rc.in" "${rc}" @ONLY)
  target_sources(${target} PRIVATE "${rc}")
endfunction()
